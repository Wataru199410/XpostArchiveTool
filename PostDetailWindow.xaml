<Window x:Class="XPostArchive.Desktop.PostDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="投稿詳細"
        Height="760"
        Width="980"
        MinHeight="620"
        MinWidth="820"
        Background="#F3F4F8">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="12">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="タグ編集" Margin="0,4,0,0" Foreground="#2563EB" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubTitleText" Margin="0,4,0,0" Foreground="#6B7280" TextWrapping="Wrap"/>
                <TextBlock x:Name="TweetText" Margin="0,10,0,0" Foreground="#111827" TextWrapping="Wrap"/>
                <TextBlock x:Name="TagText" Margin="0,10,0,0" Foreground="#6B7280" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   Margin="2,12,2,10"
                   Text="タグ"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#111827"/>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <ItemsControl x:Name="TagItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#EEF2FF" CornerRadius="999" Margin="0,0,8,8" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Foreground="#3730A3" VerticalAlignment="Center"/>
                                    <Button Content="x"
                                            Tag="{Binding Name}"
                                            Click="RemoveTag_Click"
                                            Margin="8,0,0,0"
                                            Width="20"
                                            Height="20"
                                            Padding="0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBox x:Name="NewTagText"
                             Width="260"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             GotKeyboardFocus="NewTagText_GotKeyboardFocus"
                             InputMethod.IsInputMethodEnabled="True"
                             InputMethod.PreferredImeState="On"
                             Language="ja-JP"/>
                    <Button Content="タグ追加" Margin="8,0,0,0" Width="92" Click="AddTag_Click"/>
                    <Button Content="タグ保存" Margin="8,0,0,0" Width="96" Click="SaveTags_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="2,0,2,10"
                   Text="画像"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#111827"/>

        <Border Grid.Row="3" Margin="0,34,0,0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="10">
            <ListBox x:Name="ImageList" BorderThickness="0" MouseDoubleClick="ImageList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="210" Height="140" CornerRadius="8" Background="#E5E7EB">
                                    <Image Source="{Binding FullPath}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Display}" Foreground="#111827" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FullPath}" Margin="0,6,0,0" Foreground="#6B7280" TextWrapping="Wrap"/>
                                    <Button Content="画像を開く"
                                            Margin="0,12,0,0"
                                            Width="100"
                                            HorizontalAlignment="Left"
                                            Click="OpenImage_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="フォルダを開く"
                    Width="110"
                    Padding="10,6"
                    Background="#0096FA"
                    Foreground="White"
                    BorderThickness="0"
                    Click="OpenFolder_Click"/>
            <Button Content="閉じる"
                    Width="88"
                    Margin="8,0,0,0"
                    Padding="10,6"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
