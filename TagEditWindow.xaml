<Window x:Class="XPostArchive.Desktop.TagEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="投稿タグ編集"
        Width="460"
        Height="700"
        MinWidth="400"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F6F7FB">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Panel" Color="#F1F2F6"/>
        <SolidColorBrush x:Key="Border" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="TextMain" Color="#111827"/>
        <SolidColorBrush x:Key="TextSub" Color="#6B7280"/>
        <SolidColorBrush x:Key="Primary" Color="#3B82F6"/>
        <SolidColorBrush x:Key="Error" Color="#B42318"/>

        <Style x:Key="GhostIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="SuggestionRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="投稿タグ編集"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"
                       VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,14,0,14"
                Background="{StaticResource Panel}"
                CornerRadius="14"
                Padding="14">
            <StackPanel>
                <TextBlock Text="この投稿に付いているタグを編集できます。"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextMain}"/>
                <TextBlock Text="× を押すとそのタグを投稿から外します。タグを追加するとすぐ保存されます。"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSub}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="作品タグ"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextMain}"/>
                <TextBlock Grid.Column="1"
                           x:Name="TagCountText"
                           FontSize="16"
                           Foreground="{StaticResource TextSub}"/>
            </Grid>

            <TextBlock Grid.Row="1"
                       x:Name="StatusText"
                       Margin="0,10,0,0"
                       Foreground="{StaticResource TextSub}"
                       TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="2"
                          Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="追加済みタグ"
                               Margin="0,0,0,10"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSub}"/>

                    <ItemsControl x:Name="SelectedTagsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border}"
                                        BorderThickness="1"
                                        Background="{StaticResource Surface}"
                                        CornerRadius="12"
                                        Margin="0,0,0,10"
                                        Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Display}"
                                                   FontSize="18"
                                                   Foreground="{StaticResource TextMain}"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                Tag="{Binding Name}"
                                                Content="×"
                                                Style="{StaticResource GhostIconButton}"
                                                Click="RemoveTag_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="ShowAddTagButton"
                            Content="タグを追加"
                            Margin="0,6,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource Primary}"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="ShowAddTag_Click"/>

                    <StackPanel x:Name="AddTagPanel"
                                Visibility="Collapsed"
                                Margin="0,8,0,0">
                        <TextBlock x:Name="SuggestionHeaderText"
                                   Text="候補から追加"
                                   Margin="0,0,0,10"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSub}"
                                   Visibility="Collapsed"/>

                        <Border x:Name="SuggestionPanel"
                                Margin="0,0,0,10"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="1"
                                Background="{StaticResource Surface}"
                                CornerRadius="12"
                                Visibility="Collapsed">
                            <ListBox x:Name="SuggestionListBox"
                                     BorderThickness="0"
                                     Background="Transparent">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Name}"
                                                Style="{StaticResource SuggestionRowButton}"
                                                Click="AddSuggestionButton_Click">
                                            <Grid Margin="12,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       Foreground="{StaticResource TextMain}"
                                                       FontSize="18"/>

                                            <TextBlock Grid.Column="1"
                                                       Width="28"
                                                       Margin="12,0,10,0"
                                                       Text="{Binding ActionLabel}"
                                                       Foreground="{StaticResource Primary}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding CountLabel}"
                                                       Foreground="{StaticResource TextSub}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Border BorderBrush="#BFDBFE"
                                BorderThickness="2"
                                Background="{StaticResource Surface}"
                                CornerRadius="10"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TagInputTextBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TagInputTextBox_TextChanged"
                                         KeyDown="TagInputTextBox_KeyDown"
                                         GotKeyboardFocus="TagInputTextBox_GotKeyboardFocus"
                                         InputMethod.IsInputMethodEnabled="True"
                                         InputMethod.PreferredImeState="On"
                                         Language="ja-JP"/>
                                <TextBlock x:Name="TagInputPlaceholder"
                                           Text="タグを追加"
                                           Margin="2,0,0,0"
                                           Foreground="{StaticResource TextSub}"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="TagInputCountText"
                                           Foreground="{StaticResource TextSub}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Background="{StaticResource Panel}"
                CornerRadius="20"
                Padding="14">
            <TextBlock Text="閉じる"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"
                       Cursor="Hand"
                       MouseLeftButtonUp="CloseLabel_Click"/>
        </Border>
    </Grid>
</Window>
