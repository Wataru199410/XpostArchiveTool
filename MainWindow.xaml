<Window x:Class="XPostArchive.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XPostArchive.Desktop"
        Title="X Post Archive"
        Height="820"
        Width="1380"
        MinWidth="1100"
        MinHeight="720"
        Background="#F3F4F8">
    <Window.Resources>
        <local:FileImageSourceConverter x:Key="FileImageSourceConverter"/>
        <local:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <local:VideoItemStatusVisibilityConverter x:Key="VideoItemStatusVisibilityConverter"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MutedSurface" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="TextMain" Color="#111827"/>
        <SolidColorBrush x:Key="TextSub" Color="#6B7280"/>
        <SolidColorBrush x:Key="Primary" Color="#0096FA"/>
        <SolidColorBrush x:Key="TagBg" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="TagText" Color="#3730A3"/>
        <SolidColorBrush x:Key="ShellBg" Color="#E9EEF7"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InlineIconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TagBg}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="SelectableTextDisplay" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TagFilterListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TagFilterListItem_PreviewMouseLeftButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource ShellBg}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,24,12,0">
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="&#x4E00;&#x89A7;&#x306B;&#x623B;&#x308B;"
                            Click="Home_Click"
                            Content="&#xE80F;"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Height="38"
                        CornerRadius="19"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        Padding="12,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSub}"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Height="24"
                                 Margin="10,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 TextChanged="SearchBox_TextChanged"
                                 GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                                 ToolTip="&#x691C;&#x7D22;&#x6B04;"
                                 InputMethod.IsInputMethodEnabled="True"
                                 InputMethod.PreferredImeState="On"
                                 Language="ja-JP"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" MinWidth="340"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="&#x6295;&#x7A3F;&#x4E00;&#x89A7;" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="&#xE72C;"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="&#x4E00;&#x89A7;&#x3092;&#x66F4;&#x65B0;"
                                            Style="{StaticResource InlineIconButton}"
                                            Click="ReloadPosts_Click"/>
                                </Grid>
                                <TextBox x:Name="TagSummaryText" Margin="0,6,0,0" Foreground="{StaticResource TextSub}" Text="&#x3059;&#x3079;&#x3066;&#x306E;&#x6295;&#x7A3F;&#x3092;&#x8868;&#x793A;&#x4E2D;" Style="{StaticResource SelectableTextDisplay}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                <TextBlock Text="&#x4E26;&#x3073;&#x66FF;&#x3048;" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" HorizontalAlignment="Left"/>
                                <ComboBox x:Name="SortOrderComboBox"
                                          Width="190"
                                          Height="34"
                                          Margin="0,6,0,0"
                                          SelectionChanged="SortOrderComboBox_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,12,0,0" Background="{StaticResource MutedSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#x30BF;&#x30B0;&#x4E00;&#x89A7;" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <Button Grid.Column="1"
                                            Content="&#x30BF;&#x30B0;&#x7BA1;&#x7406;"
                                            Width="92"
                                            Click="ManageTags_Click"/>
                                </Grid>
                                <TextBlock Text="&#x30BF;&#x30B0;&#x3067;&#x6295;&#x7A3F;&#x4E00;&#x89A7;&#x3092;&#x7D5E;&#x308A;&#x8FBC;&#x307F;&#x3067;&#x304D;&#x307E;&#x3059;&#x3002;&#x672A;&#x4F7F;&#x7528;&#x306E;&#x30BF;&#x30B0;&#x3082;&#x8868;&#x793A;&#x3055;&#x308C;&#x307E;&#x3059;&#x3002;"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource TextSub}"
                                           TextWrapping="Wrap"/>
                                <ListBox x:Name="TagFilterList"
                                         Margin="0,10,0,0"
                                         SelectionMode="Multiple"
                                         SelectionChanged="TagFilterList_SelectionChanged"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ItemContainerStyle="{StaticResource TagFilterListItemStyle}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TagFilterChip"
                                                    Style="{StaticResource TagChip}"
                                                    Background="{StaticResource TagBg}">
                                                <TextBlock x:Name="TagFilterChipText"
                                                           Text="{Binding Display}"
                                                           Foreground="{StaticResource TagText}"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                                    <Setter TargetName="TagFilterChip" Property="Background" Value="#E0F2FE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                                    <Setter TargetName="TagFilterChipText" Property="Foreground" Value="#075985"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter TargetName="TagFilterChip" Property="Background" Value="{StaticResource Primary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter TargetName="TagFilterChipText" Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             x:Name="PostsCardList"
                             Margin="0,12,0,0"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="PostsCardList_PreviewMouseWheel"
                             SelectionChanged="PostsCardList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10" Background="White" PreviewMouseLeftButtonDown="PostCard_PreviewMouseLeftButtonDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="112" Height="78" CornerRadius="8" Background="#E5E7EB" VerticalAlignment="Top">
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource FileImageSourceConverter}}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBox Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Style="{StaticResource SelectableTextDisplay}"/>
                                            <TextBox Text="{Binding SavedAt, Mode=OneWay}" Margin="0,2,0,0" Foreground="{StaticResource TextSub}" FontSize="12" Style="{StaticResource SelectableTextDisplay}"/>
                                            <TextBox Text="{Binding Text, Mode=OneWay}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMain}" MaxHeight="56" AcceptsReturn="True" Style="{StaticResource SelectableTextDisplay}"/>
                                            <TextBox Text="{Binding Tags, Mode=OneWay}" Margin="0,8,0,0" Foreground="{StaticResource TextSub}" FontSize="12" Style="{StaticResource SelectableTextDisplay}"/>
                                            <TextBox Text="{Binding VideoStatusText, Mode=OneWay}" Margin="0,6,0,0" Foreground="{StaticResource Primary}" FontSize="12" Visibility="{Binding VideoCount, Converter={StaticResource IntToVisibilityConverter}}" Style="{StaticResource SelectableTextDisplay}"/>
                                            <StackPanel Margin="0,8,0,0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <Button Content="&#x524A;&#x9664;" Width="64" HorizontalAlignment="Left" Background="#DC2626" Foreground="White" BorderThickness="0" Click="CardDeletePost_Click"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left">
                                                    <Button Content="&#x5F15;&#x7528;&#x5143;&#x3078;" Width="84" HorizontalAlignment="Left" Click="CardOpenQuotedPost_Click" IsEnabled="{Binding HasQuotedPost}"/>
                                                    <Button Content="&#x5F15;&#x7528;&#x5148;&#x3078;" Width="84" Margin="8,0,0,0" HorizontalAlignment="Left" Click="CardOpenReferencingPost_Click" IsEnabled="{Binding HasReferencingPost}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="12"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True"/>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel>
                        <StackPanel>
                            <TextBox x:Name="DetailTitleText" Text="&#x6295;&#x7A3F;&#x8A73;&#x7D30;" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextMain}" Style="{StaticResource SelectableTextDisplay}"/>
                            <TextBox x:Name="DetailSubTitleText"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSub}"
                                       TextWrapping="Wrap"
                                       Text="&#x5DE6;&#x306E;&#x4E00;&#x89A7;&#x304B;&#x3089;&#x6295;&#x7A3F;&#x3092;&#x9078;&#x629E;&#x3057;&#x3066;&#x304F;&#x3060;&#x3055;&#x3044;&#x3002;" Style="{StaticResource SelectableTextDisplay}"/>
                            <StackPanel Margin="0,8,0,0">
                                <Button Content="&#x6295;&#x7A3F;&#x3092;&#x524A;&#x9664;" Width="120" Padding="10,6" Background="#DC2626" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Click="DeletePost_Click"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="OpenQuotedPostButton" Width="160" HorizontalAlignment="Left" Visibility="Collapsed" Content="&#x5F15;&#x7528;&#x5143;&#x306E;&#x6295;&#x7A3F;&#x3092;&#x958B;&#x304F;" Click="OpenQuotedPost_Click"/>
                                    <Button x:Name="OpenReferencingPostButton" Width="160" Margin="10,0,0,0" HorizontalAlignment="Left" Visibility="Collapsed" Content="&#x5F15;&#x7528;&#x5148;&#x306E;&#x6295;&#x7A3F;&#x3092;&#x958B;&#x304F;" Click="OpenReferencingPost_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Margin="0,12,0,0" Background="{StaticResource MutedSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="&#x6295;&#x7A3F;&#x672C;&#x6587;" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBox x:Name="DetailTweetText"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMain}"
                                           Text="&#x4E00;&#x89A7;&#x304B;&#x3089;&#x6295;&#x7A3F;&#x3092;&#x9078;&#x629E;&#x3059;&#x308B;&#x3068;&#x3001;&#x3053;&#x3053;&#x306B;&#x672C;&#x6587;&#x304C;&#x8868;&#x793A;&#x3055;&#x308C;&#x307E;&#x3059;&#x3002;" AcceptsReturn="True" Style="{StaticResource SelectableTextDisplay}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Background="{StaticResource MutedSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="&#x30BF;&#x30B0;" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>

                                <TextBox x:Name="DetailTagText"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSub}"
                                           Text="&#x30BF;&#x30B0;: &#x306A;&#x3057;" Style="{StaticResource SelectableTextDisplay}"/>

                                <ItemsControl x:Name="DetailTagItems" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagChip}">
                                                <TextBox Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TagText}" Style="{StaticResource SelectableTextDisplay}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="OpenTagEditorButton"
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="18"
                                        Foreground="{StaticResource Primary}"
                                        Cursor="Hand"
                                        ToolTip="&#x30BF;&#x30B0;&#x3092;&#x7DE8;&#x96C6;"
                                        Content="+"
                                        Click="OpenTagEditor_Click"/>

                                <TextBox x:Name="TagActionStatusText"
                                           Margin="0,10,0,0"
                                           Foreground="{StaticResource TextSub}"
                                           Text="" Style="{StaticResource SelectableTextDisplay}"/>

                                <TextBlock Text="&#x30E1;&#x30E2;" Margin="0,12,0,0" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBox x:Name="DetailNoteTextBox"
                                         Margin="0,8,0,0"
                                         MinHeight="90"
                                         AcceptsReturn="True"
                                         TextChanged="DetailNoteTextBox_TextChanged"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="&#x30E1;&#x30E2;&#x3092;&#x4FDD;&#x5B58;"
                                            MinWidth="120"
                                            FontSize="15"
                                            Style="{StaticResource PillPrimaryButton}"
                                            Click="SaveDetailEdits_Click"/>
                                    <TextBox x:Name="DetailSaveStatusText"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSub}"
                                               Text="" Style="{StaticResource SelectableTextDisplay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Background="{StaticResource MutedSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="&#x30E1;&#x30C7;&#x30A3;&#x30A2;" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <ListBox x:Name="DetailMediaList"
                                         Margin="0,10,0,0"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         MouseDoubleClick="DetailMediaList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="96" Height="72" CornerRadius="8" Background="#E5E7EB">
                                                        <Image Source="{Binding FullPath, Converter={StaticResource FileImageSourceConverter}}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBox Text="{Binding Display, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Style="{StaticResource SelectableTextDisplay}"/>
                                                        <TextBox Text="{Binding StatusTextDisplay, Mode=OneWay}" Margin="0,4,0,0" Foreground="{StaticResource Primary}" FontSize="12" Visibility="{Binding Type, Converter={StaticResource VideoItemStatusVisibilityConverter}}" Style="{StaticResource SelectableTextDisplay}"/>
                                                        <TextBox Text="{Binding FullPath, Mode=OneWay}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSub}" FontSize="12" AcceptsReturn="True" Style="{StaticResource SelectableTextDisplay}"/>
                                                        <Button Content="&#x958B;&#x304F;"
                                                                Width="72"
                                                                Margin="0,8,0,0"
                                                                HorizontalAlignment="Left"
                                                                Click="OpenMedia_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="&#x4FDD;&#x5B58;&#x30D5;&#x30A9;&#x30EB;&#x30C0;&#x3092;&#x958B;&#x304F;"
                                    Width="120"
                                    Padding="10,6"
                                    Background="#0096FA"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="OpenFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBox Grid.Row="2" x:Name="ListStatsText" Margin="2,10,2,0" Foreground="{StaticResource TextSub}" Style="{StaticResource SelectableTextDisplay}"/>
    </Grid>
</Window>
