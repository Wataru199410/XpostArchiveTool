<Window x:Class="XPostArchive.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X Post Archive"
        Height="820"
        Width="1380"
        MinWidth="1100"
        MinHeight="720"
        Background="#F3F4F8">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MutedSurface" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Border" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="TextMain" Color="#111827"/>
        <SolidColorBrush x:Key="TextSub" Color="#6B7280"/>
        <SolidColorBrush x:Key="Primary" Color="#0096FA"/>
        <SolidColorBrush x:Key="TagBg" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="TagText" Color="#3730A3"/>
        <SolidColorBrush x:Key="ShellBg" Color="#E9EEF7"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TagBg}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource ShellBg}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,24,12,0">
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="一覧に戻る"
                            Click="Home_Click"
                            Content="&#xE80F;"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" Background="#111827" CornerRadius="21" Margin="0,0,10,0">
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="検索欄" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text="投稿本文、投稿者、タグ、Tweet ID で絞り込みできます。"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource TextSub}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBox x:Name="SearchBox"
                             Height="40"
                             VerticalContentAlignment="Center"
                             Padding="12,0"
                             Margin="0,10,0,0"
                             TextChanged="SearchBox_TextChanged"
                             GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                             ToolTip="検索欄"
                             InputMethod.IsInputMethodEnabled="True"
                             InputMethod.PreferredImeState="On"
                             Language="ja-JP"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Border Background="#EEF2FF" CornerRadius="999" Padding="10,4" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <TextBlock x:Name="ApiStatusText" Text="API: 起動確認中..." Foreground="{StaticResource TagText}" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="疎通確認" Style="{StaticResource PrimaryButton}" Width="78" Click="HealthCheck_Click"/>
                        <Button Content="再読込" Style="{StaticResource PrimaryButton}" Width="78" Margin="8,0,0,0" Click="ReloadPosts_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="投稿一覧" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                        <TextBlock x:Name="TagSummaryText" Margin="0,6,0,0" Foreground="{StaticResource TextSub}" Text="すべての投稿を表示中"/>

                        <Border Margin="0,12,0,0" Background="{StaticResource MutedSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="タグ一覧" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    <Button Grid.Column="1"
                                            Content="タグ管理"
                                            Width="92"
                                            Click="ManageTags_Click"/>
                                </Grid>
                                <TextBlock Text="タグで投稿一覧を絞り込みできます。未使用のタグも表示されます。"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource TextSub}"
                                           TextWrapping="Wrap"/>
                                <ListBox x:Name="TagFilterList"
                                         Margin="0,10,0,0"
                                         SelectionChanged="TagFilterList_SelectionChanged"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource TagChip}">
                                                <TextBlock Text="{Binding Display}" Foreground="{StaticResource TagText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             x:Name="PostsCardList"
                             Margin="0,12,0,0"
                             BorderThickness="0"
                             SelectionChanged="PostsCardList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10" Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="112" Height="78" CornerRadius="8" Background="#E5E7EB" VerticalAlignment="Top">
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Author}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                            <TextBlock Text="{Binding SavedAt}" Margin="0,2,0,0" Foreground="{StaticResource TextSub}" FontSize="12"/>
                                            <TextBlock Text="{Binding Text}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMain}" MaxHeight="56"/>
                                            <TextBlock Text="{Binding Tags}" Margin="0,8,0,0" Foreground="{StaticResource TextSub}" FontSize="12"/>
                                            <Button Content="投稿詳細を開く" Width="110" HorizontalAlignment="Left" Margin="0,8,0,0" Click="CardOpenDetail_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="DetailTitleText" Text="投稿詳細" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                            <TextBlock x:Name="DetailSubTitleText"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSub}"
                                       TextWrapping="Wrap"
                                       Text="左の一覧から投稿を選択してください。"/>
                        </StackPanel>

                        <Border Margin="0,12,0,0" Background="{StaticResource MutedSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="投稿本文" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock x:Name="DetailTweetText"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMain}"
                                           Text="一覧から投稿を選択すると、ここに本文が表示されます。"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Background="{StaticResource MutedSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="タグ" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBlock x:Name="DetailTagText"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSub}"
                                           Text="タグ: なし"/>

                                <ItemsControl x:Name="DetailTagItems" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#EEF2FF" CornerRadius="999" Margin="0,0,8,8" Padding="10,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="#3730A3" VerticalAlignment="Center"/>
                                                    <Button Content="×"
                                                            Tag="{Binding Name}"
                                                            Margin="8,0,0,0"
                                                            Width="22"
                                                            Height="22"
                                                            Padding="0"
                                                            Click="RemoveTag_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBox x:Name="NewTagText"
                                             Width="240"
                                             Height="32"
                                             VerticalContentAlignment="Center"
                                             Padding="8,0"
                                             GotKeyboardFocus="NewTagText_GotKeyboardFocus"
                                             InputMethod.IsInputMethodEnabled="True"
                                             InputMethod.PreferredImeState="On"
                                             Language="ja-JP"/>
                                    <Button Content="タグを追加" Margin="8,0,0,0" Width="92" Click="AddTag_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ComboBox x:Name="ExistingTagComboBox"
                                              Width="240"
                                              Height="32">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}"
                                                           Foreground="{Binding ForegroundBrush}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="AddExistingTagButton"
                                            Content="既存タグ追加"
                                            Margin="8,0,0,0"
                                            Width="92"
                                            Click="AddExistingTagButton_Click"/>
                                </StackPanel>

                                <TextBlock x:Name="TagActionStatusText"
                                           Margin="0,10,0,0"
                                           Foreground="{StaticResource TextSub}"
                                           Text=""/>

                                <TextBlock Text="メモ" Margin="0,12,0,0" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <TextBox x:Name="DetailNoteTextBox"
                                         Margin="0,8,0,0"
                                         MinHeight="90"
                                         AcceptsReturn="True"
                                         TextChanged="DetailNoteTextBox_TextChanged"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="メモを保存"
                                            Width="92"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="SaveDetailEdits_Click"/>
                                    <TextBlock x:Name="DetailSaveStatusText"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSub}"
                                               Text=""/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Background="{StaticResource MutedSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="メディア" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                <ListBox x:Name="DetailMediaList"
                                         Margin="0,10,0,0"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         MouseDoubleClick="DetailMediaList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="96" Height="72" CornerRadius="8" Background="#E5E7EB">
                                                        <Image Source="{Binding FullPath}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                                        <TextBlock Text="{Binding FullPath}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSub}" FontSize="12"/>
                                                        <Button Content="開く"
                                                                Width="72"
                                                                Margin="0,8,0,0"
                                                                HorizontalAlignment="Left"
                                                                Click="OpenMedia_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="保存フォルダを開く"
                                    Width="120"
                                    Padding="10,6"
                                    Background="#0096FA"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="OpenFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="ListStatsText" Margin="2,10,2,0" Foreground="{StaticResource TextSub}"/>
    </Grid>
</Window>
